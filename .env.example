# ─── DevForge — Variables de entorno ─────────────────────────────────────────
# Copiá este archivo como .env y completá los valores reales.
# NUNCA commitees el .env con valores reales al repositorio.
#
# ─── Groq API ────────────────────────────────────────────────────────────────
# Obtenés la key en: https://console.groq.com → API Keys
# Usada para: evaluación de respuestas, generación de hints, extracción de topics
VITE_GROQ_API_KEY=tu_groq_api_key_aqui

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Obtenés ambos valores en: Supabase Dashboard → Settings → API
#
# Project URL — dirección única de tu proyecto Supabase
# Formato: https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Anon Key — clave pública para el frontend (NO es secreta)
# Es seguro incluirla en el bundle de Vite. La seguridad real
# está en las RLS (Row Level Security) policies de Supabase.
# IMPORTANTE: nunca uses la service_role key en el frontend.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
